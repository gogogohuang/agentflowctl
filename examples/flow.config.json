{
  "cycle": ["claude", "codex"],
  "fixStrategy": "ring",
  "tddSplit": true,
  "reviewQuorum": 1,
  "planReviewQuorum": 1,
  "planArbiter": true,
  "tieBreak": "proceed",
  "maxAgentRuns": 60,
  "defaultModels": { "claude": "Claude 模型名稱", "codex": "Codex 模型名稱" },
  "agents": {
    "claude": { "adapter": "claude" },
    "codex": { "adapter": "codex" }
  },
  "install": "pnpm ci",
  "test": "npx vitest run",
  "checks": [
    { "name": "typecheck", "cmd": "npx tsc --noEmit" },
    { "name": "lint", "cmd": "npx eslint ." },
    { "name": "test", "cmd": "npx vitest run" },
    { "name": "build", "cmd": "npx vite build" }
  ]
}
