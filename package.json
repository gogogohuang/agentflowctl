{
  "name": "agentflowctl",
  "license": "MIT",
  "version": "0.21.3",
  "description": "讓 Claude Code、Codex、Gemini CLI 等 agent 分工整理需求、規劃、寫測試與程式並交叉審查，最後建立 PR；由程式推進流程，以測試與檢查結果把關",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "codex",
    "gemini",
    "code-review",
    "tdd",
    "cli"
  ],
  "author": "Jin-Ze Huang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogogohuang/agentflowctl.git"
  },
  "homepage": "https://github.com/gogogohuang/agentflowctl#readme",
  "bugs": {
    "url": "https://github.com/gogogohuang/agentflowctl/issues"
  },
  "type": "module",
  "bin": {
    "agentflowctl": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "prompts",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
